# Azure Foundry project endpoint (required)
# Example: https://<your-project>.services.ai.azure.com/api/projects/<project-name>
AZURE_FOUNDRY_PROJECT_ENDPOINT=

# Model deployment name used by Responses API (required)
# This should be your deployed model name in Azure AI Foundry.
AZURE_OPENAI_RESPONSES_DEPLOYMENT_NAME=
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=

# Optional: enable/disable Microsoft Learn MCP tool
MS_LEARN_MCP_ENABLED=true

# Optional: override Microsoft Learn MCP URL
MS_LEARN_MCP_URL=https://learn.microsoft.com/api/mcp

# Supported aliases (use these only if preferred):
# AZURE_AI_PROJECT_ENDPOINT=
# AZURE_AI_MODEL_DEPLOYMENT_NAME=
# AZURE_FOUNDRY_PROJECT_DEPLOYMENT_NAME=
# AZURE_OPENAI_DEPLOYMENT_NAME=
