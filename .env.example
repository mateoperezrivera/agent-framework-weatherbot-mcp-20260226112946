# --- Required: Azure OpenAI (key auth) ---
# Get these from Azure AI Foundry > your project > deployed model
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_MODEL=

# --- Optional: Application Insights tracing ---
# Get the connection string from Azure Portal > your AI Foundry project > Application Insights
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# AZURE_EXPERIMENTAL_ENABLE_GENAI_TRACING=true
